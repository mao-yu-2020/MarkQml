@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(Qt6 COMPONENTS Quick)

# 创建 bundled cmark-gfm IMPORTED 目标（库随 RenderMark 一起安装，无需外部 vcpkg）
if(NOT TARGET cmark-gfm)
    if(WIN32)
        add_library(cmark-gfm SHARED IMPORTED)
        set_target_properties(cmark-gfm PROPERTIES
            IMPORTED_IMPLIB "${PACKAGE_PREFIX_DIR}/lib/${CMAKE_IMPORT_LIBRARY_PREFIX}cmark-gfm${CMAKE_IMPORT_LIBRARY_SUFFIX}"
            IMPORTED_LOCATION "${PACKAGE_PREFIX_DIR}/bin/${CMAKE_SHARED_LIBRARY_PREFIX}cmark-gfm${CMAKE_SHARED_LIBRARY_SUFFIX}"
        )
    else()
        add_library(cmark-gfm STATIC IMPORTED)
        if(ANDROID)
            set_target_properties(cmark-gfm PROPERTIES
                IMPORTED_LOCATION "${PACKAGE_PREFIX_DIR}/lib/${CMAKE_STATIC_LIBRARY_PREFIX}cmark-gfm_static${CMAKE_STATIC_LIBRARY_SUFFIX}"
            )
        else()
            set_target_properties(cmark-gfm PROPERTIES
                IMPORTED_LOCATION "${PACKAGE_PREFIX_DIR}/lib/${CMAKE_STATIC_LIBRARY_PREFIX}cmark-gfm${CMAKE_STATIC_LIBRARY_SUFFIX}"
            )
        endif()
    endif()
endif()

if(NOT TARGET cmark-gfm-extensions)
    if(WIN32)
        add_library(cmark-gfm-extensions SHARED IMPORTED)
        set_target_properties(cmark-gfm-extensions PROPERTIES
            IMPORTED_IMPLIB "${PACKAGE_PREFIX_DIR}/lib/${CMAKE_IMPORT_LIBRARY_PREFIX}cmark-gfm-extensions${CMAKE_IMPORT_LIBRARY_SUFFIX}"
            IMPORTED_LOCATION "${PACKAGE_PREFIX_DIR}/bin/${CMAKE_SHARED_LIBRARY_PREFIX}cmark-gfm-extensions${CMAKE_SHARED_LIBRARY_SUFFIX}"
        )
    else()
        add_library(cmark-gfm-extensions STATIC IMPORTED)
        if(ANDROID)
            set_target_properties(cmark-gfm-extensions PROPERTIES
                IMPORTED_LOCATION "${PACKAGE_PREFIX_DIR}/lib/${CMAKE_STATIC_LIBRARY_PREFIX}cmark-gfm-extensions_static${CMAKE_STATIC_LIBRARY_SUFFIX}"
            )
        else()
            set_target_properties(cmark-gfm-extensions PROPERTIES
                IMPORTED_LOCATION "${PACKAGE_PREFIX_DIR}/lib/${CMAKE_STATIC_LIBRARY_PREFIX}cmark-gfm-extensions${CMAKE_STATIC_LIBRARY_SUFFIX}"
            )
        endif()
    endif()
endif()

# 创建 RenderMarkplugin IMPORTED 目标（QML 动态插件）
if(NOT TARGET RenderMarkplugin)
    add_library(RenderMarkplugin SHARED IMPORTED)
    if(WIN32)
        set_target_properties(RenderMarkplugin PROPERTIES
            IMPORTED_IMPLIB "${PACKAGE_PREFIX_DIR}/lib/${CMAKE_IMPORT_LIBRARY_PREFIX}RenderMarkplugin${CMAKE_IMPORT_LIBRARY_SUFFIX}"
            IMPORTED_LOCATION "${PACKAGE_PREFIX_DIR}/lib/qml/RenderMark/${CMAKE_SHARED_LIBRARY_PREFIX}RenderMarkplugin${CMAKE_SHARED_LIBRARY_SUFFIX}"
        )
    else()
        set_target_properties(RenderMarkplugin PROPERTIES
            IMPORTED_LOCATION "${PACKAGE_PREFIX_DIR}/lib/qml/RenderMark/${CMAKE_SHARED_LIBRARY_PREFIX}RenderMarkplugin${CMAKE_SHARED_LIBRARY_SUFFIX}"
        )
    endif()
endif()

# 创建 RenderMark::RenderMark IMPORTED 目标（手动定义，避免导出 QML 内部资源目标）
if(NOT TARGET RenderMark::RenderMark)
    add_library(RenderMark::RenderMark SHARED IMPORTED)
    if(WIN32)
        set_target_properties(RenderMark::RenderMark PROPERTIES
            IMPORTED_IMPLIB "${PACKAGE_PREFIX_DIR}/lib/${CMAKE_IMPORT_LIBRARY_PREFIX}RenderMark${CMAKE_IMPORT_LIBRARY_SUFFIX}"
            IMPORTED_LOCATION "${PACKAGE_PREFIX_DIR}/bin/${CMAKE_SHARED_LIBRARY_PREFIX}RenderMark${CMAKE_SHARED_LIBRARY_SUFFIX}"
        )
    else()
        set_target_properties(RenderMark::RenderMark PROPERTIES
            IMPORTED_LOCATION "${PACKAGE_PREFIX_DIR}/lib/${CMAKE_SHARED_LIBRARY_PREFIX}RenderMark${CMAKE_SHARED_LIBRARY_SUFFIX}"
        )
    endif()
    set_target_properties(RenderMark::RenderMark PROPERTIES
        INTERFACE_INCLUDE_DIRECTORIES "${PACKAGE_PREFIX_DIR}/include/RenderMark"
        INTERFACE_LINK_LIBRARIES "Qt6::Quick;cmark-gfm;cmark-gfm-extensions"
    )
endif()

# 提供 QML 导入路径变量（供外部项目 engine.addImportPath() 使用）
set(RenderMark_QML_IMPORT_PATH "${PACKAGE_PREFIX_DIR}/lib/qml")

check_required_components(RenderMark)
